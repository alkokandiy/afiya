# Bot token from @BotFather. Never commit the real value.
BOT_TOKEN=
# Owners: comma-separated Telegram user IDs that are always admin. Add sellers/drivers from the Admin screen.
ADMIN_CHAT_IDS=
# HTTPS URL where Telegram opens the shop (a tunnel to the Vite dev server, or to this server after a build).
CLIENT_URL=
# Database (afiya.db) and uploaded product photos (uploads/)
DATA_DIR=./data
PORT=8000
