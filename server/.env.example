# Comma-separated Telegram chat IDs that receive new orders and may use admin commands.
ADMIN_CHAT_IDS=
# HTTPS URL where Telegram opens the shop (a tunnel to the Vite dev server, or to this server after a build).
CLIENT_URL=
# SQLite file
DATABASE_PATH=./data/afiya.db
PORT=8000
